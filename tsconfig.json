{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "nuxt.d.ts",
    "app/**/*.ts",
    "app/**/*.vue",
    "server/**/*.ts",
    "lib/**/*.ts",
    "db/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".nuxt", ".output", "dist"]
}
