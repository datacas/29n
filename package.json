{
  "name": "affinity-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:public": "DEPLOY_TARGET=public nuxt build",
    "data:export": "node scripts/deploy/export_static.ts",
    "data:verify": "node scripts/deploy/verify_static.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:migrate": "node-pg-migrate",
    "db:migrate:dev": "node-pg-migrate --ts-config tsconfig.json --migrations-dir ./db/migrations",
    "db:seed": "node --loader ts-node/es db/seeds/001_dimensions.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "audit:fairness": "node --experimental-strip-types scripts/audit/fairness.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "compression": "^1.8.2",
    "execa": "^9.5.0",
    "node-pg-migrate": "^7.7.0",
    "nuxt": "^3.15.0",
    "pg": "^8.13.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/pg": "^8.11.0",
    "@vite-pwa/nuxt": "^2.0.4",
    "rolldown": "^1.3.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1",
    "workbox-background-sync": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  },
  "license": "MIT"
}
